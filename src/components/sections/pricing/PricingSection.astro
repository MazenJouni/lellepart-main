            4 vendég
          </a>
          <Icon name="mdi:open-in-new" class="icon" />
        </h2>
        <div class="card-badge">Négyágyas apartman</div>
      </div>
      <div class="seasons">
        <div class="season">
          <div class="season-icon-wrapper">
            <Icon name="mdi:weather-sunny" class="season-icon" />
          </div>
          <div class="season-content">
            <h3>Előszezon</h3>
            <p class="price">- 10 % kedvezmény</p>
            <p class="date">május 1. - június 9.</p>
          </div>
        </div>
        
        <div class="season highlight">
          <div class="season-icon-wrapper">
            <Icon name="mdi:beach" class="season-icon" />
          </div>
          <div class="season-content">
            <h3>Főszezon</h3>
            <p class="price">48.000,- Ft/éj</p>
            <p class="date">június 10. - augusztus 25.</p>
          </div>
        </div>
        
        <div class="season">
          <div class="season-icon-wrapper">
            <Icon name="mdi:weather-sunset" class="season-icon" />
          </div>
          <div class="season-content">
            <h3>Utószezon</h3>
            <p class="price">- 10 % kedvezmény</p>
            <p class="date">augusztus 26. - október 30.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Apartman x 6 -->
    <div class="pricing-card" data-aos="fade-up" data-aos-delay="300">
      <div class="card-header">
        <h2 class="card-title">
          <a href="products">
            <Icon name="mdi:bed" class="bed-icon" />
            6 vendég
          </a>
          <Icon name="mdi:open-in-new" class="icon" />
        </h2>
        <div class="card-badge">Hatágyas apartman</div>
      </div>
      <div class="seasons">
        <div class="season">
          <div class="season-icon-wrapper">
            <Icon name="mdi:weather-sunny" class="season-icon" />
          </div>
          <div class="season-content">
            <h3>Előszezon</h3>
            <p class="price">- 10 % kedvezmény</p>
            <p class="date">május 1. - június 9.</p>
          </div>
        </div>
        
        <div class="season highlight">
          <div class="season-icon-wrapper">
            <Icon name="mdi:beach" class="season-icon" />
          </div>
          <div class="season-content">
            <h3>Főszezon</h3>
            <p class="price">55.000 - 68.000,- Ft/éj</p>
            <p class="date">június 10. - augusztus 25.</p>
          </div>
        </div>
        
        <div class="season">
          <div class="season-icon-wrapper">
            <Icon name="mdi:weather-sunset" class="season-icon" />
          </div>
          <div class="season-content">
            <h3>Utószezon</h3>
            <p class="price">- 10 % kedvezmény</p>
