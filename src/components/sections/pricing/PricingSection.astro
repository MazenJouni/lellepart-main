---
import { Icon } from "astro-icon/components";
const title: string = "Apartman Árazás";
const description: string =
  "Fedezze fel szezonális árazási lehetőségeinket, és élvezze nyaralását a legjobb elérhető árakon"
---

<section class="hero">
  <div class="hero-content">
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
  <div class="hero-pattern"></div>
</section>

<section class="pricing-section">
  <div class="pricing-grid">
    <!-- Apartman x 2 -->
    <div class="pricing-card" data-aos="fade-up" data-aos-delay="100">
      <div class="card-header">
        <h2 class="card-title">
          <a href="products">Apartman x 2</a>
          <Icon name="mdi:open-in-new" class="icon" />
        </h2>
        <div class="card-badge">2 fő részére</div>
      </div>
      <div class="seasons">
        <div class="season">
          <div class="season-icon-wrapper">
            <Icon name="mdi:weather-sunny" class="season-icon" />
          </div>
          <div class="season-content">
            <h3>Előszezon</h3>
            <p class="price">- 10 % kedvezmény</p>
            <p class="date">május 1. - június 9.</p>
          </div>
        </div>
        
        <div class="season highlight">
          <div class="season-icon-wrapper">
            <Icon name="mdi:beach" class="season-icon" />
          </div>
          <div class="season-content">
            <h3>Főszezon</h3>
            <p class="price">33.000,- Ft/éj</p>
            <p class="date">június 10. - augusztus 25.</p>
          </div>
        </div>
        
        <div class="season">
          <div class="season-icon-wrapper">
            <Icon name="mdi:weather-sunset" class="season-icon" />
          </div>
          <div class="season-content">
            <h3>Utószezon</h3>
            <p class="price">- 10 % kedvezmény</p>
            <p class="date">augusztus 26. - október 30.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Apartman x 4 -->
