      <div class="card-header">
        <h2 class="card-title">
          <a href="products">Apartman x 4</a>
          <Icon name="mdi:open-in-new" class="icon" />
        </h2>
        <div class="card-badge">4 fő részére</div>
      </div>
      <div class="seasons">
        <div class="season">
          <div class="season-icon-wrapper">
            <Icon name="mdi:weather-sunny" class="season-icon" />
          </div>
          <div class="season-content">
            <h3>Előszezon</h3>
            <p class="price">- 10 % kedvezmény</p>
            <p class="date">május 1. - június 9.</p>
          </div>
        </div>
        
        <div class="season highlight">
          <div class="season-icon-wrapper">
            <Icon name="mdi:beach" class="season-icon" />
          </div>
          <div class="season-content">
            <h3>Főszezon</h3>
            <p class="price">45.000,- Ft/éj</p>
            <p class="date">június 10. - augusztus 25.</p>
          </div>
        </div>
        
        <div class="season">
          <div class="season-icon-wrapper">
            <Icon name="mdi:weather-sunset" class="season-icon" />
          </div>
          <div class="season-content">
            <h3>Utószezon</h3>
            <p class="price">- 10 % kedvezmény</p>
            <p class="date">augusztus 26. - október 30.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Apartman x 6 -->
    <div class="pricing-card" data-aos="fade-up" data-aos-delay="300">
      <div class="card-header">
        <h2 class="card-title">
          <a href="products">Apartman x 6</a>
          <Icon name="mdi:open-in-new" class="icon" />
        </h2>
        <div class="card-badge">6 fő részére</div>
      </div>
      <div class="seasons">
        <div class="season">
          <div class="season-icon-wrapper">
            <Icon name="mdi:weather-sunny" class="season-icon" />
          </div>
          <div class="season-content">
            <h3>Előszezon</h3>
            <p class="price">- 10 % kedvezmény</p>
            <p class="date">május 1. - június 9.</p>
          </div>
        </div>
        
        <div class="season highlight">
          <div class="season-icon-wrapper">
            <Icon name="mdi:beach" class="season-icon" />
          </div>
          <div class="season-content">
            <h3>Főszezon</h3>
            <p class="price">50.000 - 65.000,- Ft/éj</p>
            <p class="date">június 10. - augusztus 25.</p>
          </div>
        </div>
        
        <div class="season">
          <div class="season-icon-wrapper">
            <Icon name="mdi:weather-sunset" class="season-icon" />
          </div>
          <div class="season-content">
            <h3>Utószezon</h3>
            <p class="price">- 10 % kedvezmény</p>
            <p class="date">augusztus 26. - október 30.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="notes">
    <div class="note-card" data-aos="fade-up" data-aos-delay="300">
      <div class="note-icon-wrapper">
        <Icon name="mdi:information" class="note-icon" />
      </div>
      <p>Az árak nem tartalmazzák az üdülőhelyi adót!</p>
    </div>
    <div class="note-card" data-aos="fade-up" data-aos-delay="400">
      <div class="note-icon-wrapper">
        <Icon name="mdi:credit-card" class="note-icon" />
      </div>
      <p>Széchenyi Pihenőkártyát elfogadunk.</p>
    </div>
    <div class="note-card" data-aos="fade-up" data-aos-delay="500">
      <div class="note-icon-wrapper">
        <Icon name="mdi:cash" class="note-icon" />
      </div>
      <p>Foglalás 30% foglaló befizetésével történik.</p>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    min-height: 40vh;
    padding: 7rem 2rem 2rem 2rem;
    background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
    position: relative;
    overflow: hidden;
  }

  .hero-pattern {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.1) 1px, transparent 0);
    background-size: 40px 40px;
    animation: patternMove 20s linear infinite;
    pointer-events: none;
  }

  @keyframes patternMove {
    0% { transform: translateX(0) translateY(0); }
    100% { transform: translateX(-20px) translateY(-20px); }
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(45deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0) 100%);
    animation: shimmer 5s infinite linear;
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    z-index: 2;
    opacity: 0;
    animation: fadeSlideUp 1s ease-out forwards;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: white;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .hero p {
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    color: white;
    margin-bottom: 2rem;
  }

  .pricing-section {
    padding: 4rem 2rem;
    background: white;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .pricing-card {
    background: white;
    border-radius: 20px;
    box-shadow: 0 15px 35px rgba(0,0,0,0.05);
    padding: 2rem;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .pricing-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #f6d365, #fda085);
    transform: scaleX(0);
    transition: transform 0.4s ease;
    transform-origin: left;
  }

  .pricing-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
  }

  .pricing-card:hover::before {
    transform: scaleX(1);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .card-badge {
    background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .card-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 1.8rem;
    color: #333;
    margin-bottom: 2rem;
  }

  .card-title a {
    color: inherit;
    text-decoration: none;
  }

  .icon {
    width: 1.2em;
    height: 1.2em;
    color: #f6d365;
  }

  .seasons {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .season {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem;
    border-radius: 15px;
    background: rgba(246, 211, 101, 0.05);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .season::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(45deg, transparent, rgba(255,255,255,0.1), transparent);
    transform: translateX(-100%);
    transition: transform 0.6s ease;
  }

  .season:hover::before {
    transform: translateX(100%);
  }

  .season-icon-wrapper {
    background: rgba(246, 211, 101, 0.1);
    padding: 1rem;
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .season:hover .season-icon-wrapper {
    transform: scale(1.1) rotate(5deg);
    background: rgba(246, 211, 101, 0.2);
  }

  .season.highlight {
    background: rgba(246, 211, 101, 0.15);
    border: 2px solid rgba(246, 211, 101, 0.3);
  }

  .season-content {
    flex: 1;
  }

  .season-icon {
    font-size: 2rem;
    color: #f6d365;
    margin-bottom: 1rem;
  }

  .season h3 {
    font-size: 1.4rem;
    color: #333;
    margin-bottom: 0.5rem;
  }

  .price {
    font-size: 1.2rem;
    color: #f6d365;
    font-weight: bold;
    margin-bottom: 0.5rem;
  }

  .date {
    color: #666;
    font-size: 0.9rem;
  }

  .notes {
    max-width: fit-content;
    margin: 4rem auto 0;
    display: grid;
    gap: 1rem;
  }

  .note-card {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.2rem;
    background: white;
    border-radius: 12px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.05);
    transition: all 0.3s ease;
  }

  .note-card:hover {
    transform: translateX(5px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.08);
  }

  .note-icon-wrapper {
    background: rgba(246, 211, 101, 0.1);
    padding: 0.8rem;
    border-radius: 10px;
    transition: all 0.3s ease;
  }

  .note-card:hover .note-icon-wrapper {
    background: rgba(246, 211, 101, 0.2);
    transform: scale(1.1);
  }

  .note-icon {
    font-size: 1.5rem;
    color: #f6d365;
  }

  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }

  @keyframes fadeSlideUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: 6rem 1rem 2rem 1rem;
    }

    .pricing-section {
      padding: 2rem 1rem;
    }

    .pricing-grid {
      grid-template-columns: 1fr;
    }

    .card-header {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }

    .season {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
    }

    .note-card {
      flex-direction: column;
      text-align: center;
      padding: 1.5rem;
    }
  }
</style>