---
// Import the necessary dependencies.
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import MainBuilding from "src/assets/images/main_hd.png";

const title: string = "Our Services";
const subtitle: string = "We warmly welcome our dear guests to the official website of <strong><em>Lellepart Apartment House</em></strong>!";
const description: string =
  "In our apartment house, you can spend your vacation in comfortable surroundings that meet all your needs. Our own sandy beach, similar to a seaside shore, provides perfect relaxation.";

const services = [
  {
    icon: "mdi:map-marker",
    title: "Location",
    description: "Our hotel is located in the center of Balatonlelle, directly on the waterfront. Enjoy the unique panorama and proximity to Lake Balaton."
  },
  {
    icon: "mdi:bus",
    title: "Transportation",
    description: "The train station and bus station are just a few minutes' walk from our accommodation."
  },
  {
    icon: "mdi:store",
    title: "Neighborhood",
    description: "All services are available in the area: restaurants, shops, pharmacy, post office, medical clinic, and police station."
  },
  {
    icon: "mdi:beach",
    title: "Beach",
    description: "Our own sandy beach, similar to a seaside shore, is the perfect place for relaxation and recreation."
  },
  {
    icon: "mdi:home",
    title: "Accommodation",
    description: "Our modern, fully equipped apartments provide maximum comfort for our guests."
  },
  {
    icon: "mdi:parking",
    title: "Parking",
    description: "Secure, enclosed parking available on the apartment house's own property."
  }
];

const amenities = [
  {
    icon: "mdi:home",
    title: "Accommodation",
    description: "In our apartment house, you can spend your vacation in comfortable surroundings that meet all your needs."
  },
  {
    icon: "mdi:parking",
    title: "Parking",
    description: "Enclosed parking within the apartment house area."
  }
];

const phone = "+36705180525";
const phoneFormatted = "+36 70/518-0525";
const email = "lellepart1@gmail.com";
---

<section class="hero">
  <div class="hero-content">
    <h1 set:html={subtitle} />
    <p>{description}</p>
    <div class="cta-container">
      <a href="/contact" class="cta-button">Book Now</a>
      <div class="quick-contacts">
        <a href={`tel:${phone}`} class="contact-link">
          <Icon name="mdi:phone" class="contact-icon" />
          <span>{phoneFormatted}</span>
        </a>
        <a href={`mailto:${email}`} class="contact-link">
          <Icon name="mdi:email" class="contact-icon" />
          <span>{email}</span>
        </a>
      </div>
    </div>
  </div>
  <div class="hero-image">
    <Image 
      src={MainBuilding} 
      alt="Lellepart Apartment House" 
      width={800} 
      height={600}
    />
  </div>
</section>

<section class="features">
  <div class="features-grid">
    {
      services.map(service => (
        <div class="feature-card">
          <Icon name={service.icon} class="feature-icon" />
          <h3>{service.title}</h3>
          <p>{service.description}</p>
        </div>
      ))
    }
  </div>
  
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    min-height: 80vh;
    padding: 5rem 2rem 2rem 2rem;
    background: theme('backgroundImage.primary-gradient');
    position: relative;
    overflow: hidden;
    gap: 2rem;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: theme('backgroundImage.shimmer-gradient');
  }

  .hero-content {
    opacity: 0;
    animation: fadeSlideUp 1s ease-out forwards;
  }

  .hero-image {
    opacity: 0;
    animation: fadeSlideIn 1s ease-out 0.3s forwards;
  }

  @keyframes fadeSlideUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeSlideIn {
    from {
      opacity: 0;
      transform: translateX(30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .hero-image img {
    transition: transform 0.3s ease;
  }

  .hero-image img:hover {
    transform: scale(1.02);
  }

  .features-grid {
    opacity: 0;
    animation: fadeIn 1s ease-out forwards;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .feature-card {
    position: relative;
    overflow: hidden;
    background: theme('colors.background.DEFAULT');
    box-shadow: 0 20px 40px rgba(33, 147, 176, 0.1);
    border: 1px solid theme('colors.border.light');
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 2rem 1.5rem;
    transition: all 0.3s ease;
    height: 100%;
    text-align: center;
    border-radius: 24px;
  }

  .feature-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(45deg, transparent 0%, rgba(255,255,255,0.1) 50%, transparent 100%);
    transform: translateX(-100%);
    transition: transform 0.6s ease;
  }

  .feature-card:hover::before {
    transform: translateX(100%);
  }

  /* Staggered animation for feature cards */
  .feature-card {
    opacity: 0;
    animation: fadeSlideUp 0.6s ease-out forwards;
  }

  .feature-card:nth-child(1) { animation-delay: 0.1s; }
  .feature-card:nth-child(2) { animation-delay: 0.2s; }
  .feature-card:nth-child(3) { animation-delay: 0.3s; }
  .feature-card:nth-child(4) { animation-delay: 0.4s; }
  .feature-card:nth-child(5) { animation-delay: 0.5s; }
  .feature-card:nth-child(6) { animation-delay: 0.6s; }

  .cta-button {
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
    background: theme('colors.white');
    color: theme('colors.primary.500');
  }

  .cta-button::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(45deg, transparent 0%, rgba(255,255,255,0.2) 50%, transparent 100%);
    transform: translateX(-100%);
    transition: transform 0.6s ease;
  }

  .cta-button:hover::after {
    transform: translateX(100%);
  }

  .hero-content {
    flex: 1;
    padding: 2rem;
    z-index: 2;
    max-width: 600px;
  }

  .hero h1 {
    font-size: 46px;
    color: white;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .hero h1 em {
    color: theme('colors.primary.300');
    font-style: normal;
    font-weight: 700;
  }

  .hero p {
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    color: white;
    margin-bottom: 2rem;
  }

  .hero-image {
    flex: 1;
    position: relative;
    min-width: 300px;
  }

  .hero-image img {
    width: 100%;
    height: auto;
    max-height: 400px;
    border-radius: 24px;
    box-shadow: 0 20px 40px rgba(33, 147, 176, 0.1);
  }

  .cta-button {
    display: inline-block;
    padding: 1rem 2rem;
    border-radius: 50px;
    font-weight: bold;
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(33, 147, 176, 0.15);
  }

  .features {
    padding: 4rem 2rem;
    background: theme('colors.background.light');
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .feature-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 25px 45px rgba(33, 147, 176, 0.15);
  }

  .feature-icon {
    font-size: 2.8rem;
    color: theme('colors.primary.500');
    margin-bottom: 1.5rem;
    padding: 1rem;
    background: rgba(33, 147, 176, 0.1);
    border-radius: 12px;
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0% {
      background: rgba(33, 147, 176, 0.1);
    }
    50% {
      background: rgba(33, 147, 176, 0.2);
    }
    100% {
      background: rgba(33, 147, 176, 0.1);
    }
  }

  .feature-card:hover .feature-icon {
    transform: scale(1.1);
    background: rgba(33, 147, 176, 0.15);
  }

  .feature-card h3 {
    color: theme('colors.text.primary');
    margin-bottom: 1rem;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .feature-card p {
    color: theme('colors.text.secondary');
    line-height: 1.6;
    margin: 0;
    flex-grow: 1;
  }

  @media (max-width: 768px) {
    .hero {
      flex-direction: column;
      text-align: center;
      min-height: auto;
      padding: 6rem 1rem 2rem 1rem;
      gap: 1rem;
    }

    .hero-content {
      padding: 1rem;
      max-width: 100%;
    }

    .hero-image {
      margin-top: 1rem;
      width: 100%;
      min-width: auto;
    }

    .hero-image img {
      max-height: 400px;
      width: 100%;
    }

    .hero h1 {
      font-size: 2rem;
      margin-bottom: 0.5rem;
    }

    .hero p {
      font-size: 1rem;
      margin-bottom: 1.5rem;
    }

    .features {
      padding: 0.5rem 0.5rem;
      background: white;
    }

    .features-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 0 0.5rem;
    }

    .feature-card {
      border-radius: 24px;
      padding: 1.5rem 1rem;
    }

    .feature-icon {
      width: 60px;
      height: 60px;
      font-size: 2rem;
      margin-bottom: 1rem;
      border-radius: 10px;
    }

    .feature-card h3 {
      font-size: 1.3rem;
    }

    .feature-card p {
      font-size: 0.95rem;
    }
  }

  .cta-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  .quick-contacts {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: white;
    text-decoration: none;
    transition: all 0.3s ease;
    font-size: 1rem;
  }

  .contact-link:hover {
    color: theme('colors.primary.300');
    transform: translateX(5px);
  }

  .contact-icon {
    font-size: 1.2rem;
  }

  @media (max-width: 768px) {
    .cta-container {
      align-items: center;
    }

    .quick-contacts {
      align-items: center;
    }
  }
</style>
