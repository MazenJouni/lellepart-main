---
// Import the necessary dependencies.
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import MainBuilding from "src/assets/images/main_hd.png";

const title: string = "Szolgáltatásaink";
const subtitle: string = "Szeretettel várjuk, kedves vendégeinket!";
const description: string =
  "Apartmanházunkban minden kényelmet kielégítő körülmények között tudják eltölteni nyaralásukat. Saját, homokos, tengerparthoz hasonlító strandunk tökéletes kikapcsolódást nyújt.";

const services = [
  {
    icon: "mdi:map-marker",
    title: "Elhelyezkedés",
    description: "Szállodánk Balatonlelle központjában, közvetlenül a vízparton található. Élvezze a páratlan panorámát és a Balaton közelségét."
  },
  {
    icon: "mdi:bus",
    title: "Közlekedés",
    description: "A vasútállomás és az autóbusz-állomás néhány perc sétára található szálláshelyünktől."
  },
  {
    icon: "mdi:store",
    title: "Környék",
    description: "A környéken minden szolgáltatás elérhető: éttermek, üzletek, gyógyszertár, posta, orvosi rendelő és rendőrség."
  },
  {
    icon: "mdi:beach",
    title: "Strand",
    description: "Saját, homokos, tengerparthoz hasonlító strandunk tökéletes helyszín a pihenéshez és kikapcsolódáshoz."
  },
  {
    icon: "mdi:home",
    title: "Szállás",
    description: "Modern, teljesen felszerelt apartmanjaink maximális kényelmet biztosítanak vendégeink számára."
  },
  {
    icon: "mdi:parking",
    title: "Parkolás",
    description: "Biztonságos, zárt parkolási lehetőség az apartmanház saját területén."
  }
];

const amenities = [
  {
    icon: "mdi:home",
    title: "Szállás",
    description: "Apartmanházunkban minden kényelmet kielégítő körülmények között tudják eltölteni nyaralásukat."
  },
  {
    icon: "mdi:parking",
    title: "Parkolás",
    description: "Zárt parkolási lehetőség az apartmanház területén belül."
  }
];
---

<section class="hero">
  <div class="hero-content">
    <h1>{subtitle}</h1>
    <p>{description}</p>
    <a href="/contact" class="cta-button">Foglalás</a>
  </div>
  <div class="hero-image">
    <Image 
      src={MainBuilding} 
      alt="Lellepart Apartmanház" 
      width={800} 
      height={600}
    />
  </div>
</section>

<section class="features">
  <div class="features-grid">
    {
      services.map(service => (
        <div class="feature-card">
          <Icon name={service.icon} class="feature-icon" />
          <h3>{service.title}</h3>
          <p>{service.description}</p>
        </div>
      ))
    }
  </div>
  
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    min-height: 80vh;
    padding: 7rem 2rem 2rem 2rem;
    background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
    position: relative;
    overflow: hidden;
    gap: 2rem;
    position: relative;
  }

  /* Add subtle animated gradient overlay */
  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(45deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0) 100%);
    animation: shimmer 5s infinite linear;
  }

  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }

  .hero-content {
    opacity: 0;
    animation: fadeSlideUp 1s ease-out forwards;
  }

  .hero-image {
    opacity: 0;
    animation: fadeSlideIn 1s ease-out 0.3s forwards;
  }

  @keyframes fadeSlideUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeSlideIn {
    from {
      opacity: 0;
      transform: translateX(30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .hero-image img {
    transition: transform 0.3s ease;
  }

  .hero-image img:hover {
    transform: scale(1.02);
  }

  .features-grid {
    opacity: 0;
    animation: fadeIn 1s ease-out forwards;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .feature-card {
    position: relative;
    overflow: hidden;
  }

  .feature-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(45deg, transparent 0%, rgba(255,255,255,0.1) 50%, transparent 100%);
    transform: translateX(-100%);
    transition: transform 0.6s ease;
  }

  .feature-card:hover::before {
    transform: translateX(100%);
  }

  /* Staggered animation for feature cards */
  .feature-card {
    opacity: 0;
    animation: fadeSlideUp 0.6s ease-out forwards;
  }

  .feature-card:nth-child(1) { animation-delay: 0.1s; }
  .feature-card:nth-child(2) { animation-delay: 0.2s; }
  .feature-card:nth-child(3) { animation-delay: 0.3s; }
  .feature-card:nth-child(4) { animation-delay: 0.4s; }
  .feature-card:nth-child(5) { animation-delay: 0.5s; }
  .feature-card:nth-child(6) { animation-delay: 0.6s; }

  .cta-button {
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .cta-button::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(45deg, transparent 0%, rgba(255,255,255,0.2) 50%, transparent 100%);
    transform: translateX(-100%);
    transition: transform 0.6s ease;
  }

  .cta-button:hover::after {
    transform: translateX(100%);
  }

  .hero-content {
    flex: 1;
    padding: 2rem;
    z-index: 2;
    max-width: 600px;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: white;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .hero p {
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    color: white;
    margin-bottom: 2rem;
  }

  .hero-image {
    flex: 1;
    position: relative;
    min-width: 300px;
  }

  .hero-image img {
    width: 100%;
    height: auto;
    max-height: 400px;
    border-radius: 20px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.2);
  }

  .cta-button {
    display: inline-block;
    padding: 1rem 2rem;
    background: white;
    color: #f6d365;
    border-radius: 50px;
    font-weight: bold;
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }

  .features {
    padding: 4rem 2rem;
    background: white;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 2rem 1.5rem;
    background: white;
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    transition: all 0.3s ease;
    height: 100%;
    text-align: center;
  }

  .feature-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 35px rgba(0,0,0,0.1);
  }

  .feature-icon {
    font-size: 2.8rem;
    color: #f6d365;
    margin-bottom: 1.5rem;
    padding: 1rem;
    background: rgba(246, 211, 101, 0.1);
    border-radius: 50%;
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0% {
      background: rgba(246, 211, 101, 0.1);
    }
    50% {
      background: rgba(246, 211, 101, 0.3);
    }
    100% {
      background: rgba(246, 211, 101, 0.1);
    }
  }

  .feature-card:hover .feature-icon {
    transform: scale(1.1);
    background: rgba(246, 211, 101, 0.2);
  }

  .feature-card h3 {
    color: #333;
    margin-bottom: 1rem;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .feature-card p {
    color: #666;
    line-height: 1.6;
    margin: 0;
    flex-grow: 1;
  }

  @media (max-width: 768px) {
    .hero {
      flex-direction: column;
      text-align: center;
      min-height: auto;
      padding: 6rem 1rem 2rem 1rem;
      gap: 1rem;
    }

    .hero-content {
      padding: 1rem;
      max-width: 100%;
    }

    .hero-image {
      margin-top: 1rem;
      width: 100%;
      min-width: auto;
    }

    .hero-image img {
      max-height: 400px;
      width: 100%;
    }

    .hero h1 {
      font-size: 2rem;
      margin-bottom: 0.5rem;
    }

    .hero p {
      font-size: 1rem;
      margin-bottom: 1.5rem;
    }

    .features {
      padding: 0.5rem 0.5rem;
      background: white;
    }

    .features-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 0 0.5rem;
    }

    .feature-card {
      padding: 1.5rem 1rem;
    }

    .feature-icon {
      width: 60px;
      height: 60px;
      font-size: 2rem;
      margin-bottom: 1rem;
    }

    .feature-card h3 {
      font-size: 1.3rem;
    }

    .feature-card p {
      font-size: 0.95rem;
    }
  }
</style>
