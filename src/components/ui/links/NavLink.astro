---
// Destructure the properties from Astro.props
const { url, name } = Astro.props;

// Define TypeScript interface for the properties
interface Props {
  url: string;
  name: string;
}

// Get the current path from Astro.url
const currentPath = Astro.url.pathname;
// Check if this link is active by comparing with current path
const isActive = currentPath === url;
---

<!--
Re-usable link component for navigation bar. Highlights the active link
by comparing the current URL with the href of each link.
We assign an ID matching the URL for easy reference in our script.
If URL is '/' (home page), assign ID as 'home' 
-->
<a
  id={url === "/" ? "home" : url.replace("/", "")}
  href={url}
  data-astro-prefetch
  class:list={[
    "rounded-lg text-base font-medium outline-none ring-primary-500 focus-visible:ring dark:ring-primary-200 dark:focus:outline-none md:py-3 md:text-sm 2xl:text-base",
    isActive 
      ? "text-primary-500 dark:text-primary-300" 
      : "text-text-primary dark:text-text-light hover:text-primary-400 dark:hover:text-primary-400"
  ]}
  aria-current={isActive ? "page" : undefined}
>
  {name}
</a>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    let url = window.location.pathname;
    let urlSegments = url.split("/");
    let navId;

    if (url === "/") {
      navId = "home";
    } else {
      navId = url.replace("/", "");
    }

    let nav = document.getElementById(navId);

    if (nav) {
      nav.classList.remove(
        "text-text-primary",
        "dark:text-text-light",
        "hover:text-primary-400",
        "dark:hover:text-primary-400"
      );
      nav.classList.add("text-primary-500", "dark:text-primary-300");
      nav.setAttribute("aria-current", "page");
    }
  });
</script>
