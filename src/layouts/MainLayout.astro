---
import Meta from "@components/Meta.astro";
import Navbar from "@components/sections/navbar&footer/Navbar.astro";
import FooterSection from "@components/sections/navbar&footer/FooterSection.astro";
import { SITE } from "@data/constants";
import { Image } from "astro:assets";
import Logo from "src/assets/images/Logo_white.svg";
import { ViewTransitions } from "astro:transitions";

const { title = SITE.title, meta, structuredData, lang = "en" } = Astro.props;
interface Props {
  title?: string;
  meta?: string;
  structuredData?: object;
  lang?: string;
}

const currentPath = Astro.url.pathname;
---

<html lang={lang} class="scrollbar-hide lenis lenis-smooth scroll-pt-16">
  <head>
    <Meta meta={meta} structuredData={structuredData} />
    <title>{title}</title>
    <ViewTransitions />
    <script>
      import "@scripts/lenisSmoothScroll.js";
    </script>
  </head>
  <body
  class="bg-gradient-to-r from-[#2193b0] to-[#6dd5ed] selection:bg-neutral-400 selection:text-neutral-100"
  >
    {
      currentPath === "/" && (
        <div class="welcome-screen">
          <div class="welcome-content">
            <div class="logo-container animate-welcomeText">
              <Image
                src={Logo}
                alt="Lellepart Apartmanház Logo"
                class="welcome-logo"
                width={400}
                height={400}
              />
            </div>
            <h1 class="animate-welcomeText mb-4 text-4xl font-bold text-white md:text-6xl">
              
            </h1>
            <p class="animate-welcomeText animation-delay-300 text-xl text-white/90 md:text-2xl">
              Tökéletes kikapcsolódás a Balatonnál
            </p>
            <div class="loading-bar" />
          </div>
        </div>
      )
    }

    <div class="main-content">
      <Navbar />
      <div class="custom-container">
        <main
          style={currentPath.includes("products/") ? "margin-top: 4rem;" : ""}
        >
          <slot />
        </main>
      </div>
      <FooterSection />
    </div>

    <style>
      .scrollbar-hide::-webkit-scrollbar {
        display: none;
      }
      .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
      .custom-container {
        margin: 0 auto;
      }
      .welcome-screen {
        position: fixed;
        inset: 0;
        height: 100vh;
        background: theme('backgroundImage.primary-gradient-alt');
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2000;
        animation: welcomeScreenFade 0.5s ease-in-out forwards 3s;
      }
      .welcome-content {
        text-align: center;
        padding: 2rem;
      }
      .loading-bar {
        width: 200px;
        height: 3px;
        margin: 2rem auto;
        position: relative;
        background: rgba(255, 255, 255, 0.1);
        overflow: hidden;
      }
      .loading-bar::after {
        content: "";
        position: absolute;
        inset: 0;
        width: 0;
        background: white;
        animation: loadingBarProgress 2s ease-in-out forwards;
      }
      .main-content {
        position: relative;
      }
      .logo-container {
        display: flex;
        justify-content: center;
      }
      .welcome-logo {
        max-width: 400px;
        height: auto;
      }

      @keyframes welcomeScreenFade {
        to {
          opacity: 0;
          transform: scale(1.1);
          visibility: hidden;
        }
      }
      @keyframes loadingBarProgress {
        to {
          width: 100%;
        }
      }
      @keyframes welcomeText {
        from {
          opacity: 0;
          transform: translateY(30px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .animate-welcomeText {
        opacity: 0;
        animation: welcomeText 0.8s ease-out forwards;
      }
      .animation-delay-300 {
        animation-delay: 2s;
      }

      @media (max-width: 640px) {
        .welcome-content h1 {
          font-size: 2rem;
          line-height: 1.2;
        }
        .welcome-content p {
          font-size: 1.125rem;
        }
        .loading-bar {
          width: 150px;
        }
        .welcome-logo {
          max-width: 150px;
        }
        .logo-container {
          margin-bottom: 1.5rem;
        }
      }
    </style>
  </body>
</html>
