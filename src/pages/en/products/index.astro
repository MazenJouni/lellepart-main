---
// Importing necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import CardSmall from "@components/ui/cards/CardSmall.astro";
import CardWide from "@components/ui/cards/CardWide.astro";
import FeaturesStatsAlt from "@components/sections/features/FeaturesStatsAlt.astro";

// Importing necessary functions from Astro
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { SITE } from "@data/constants";

// Fetching all the product related content and sorting it by main.id
const product: CollectionEntry<"products">[] = (
  await getCollection("products")
).sort(
  (a: CollectionEntry<"products">, b: CollectionEntry<"products">) =>
    (a.data.main?.id || 0) - (b.data.main?.id || 0),
);

// Define variables for page content
const title: string = "Our Apartments";
const subTitle: string =
  "Explore the various apartment options at our apartment house and find the accommodation that suits you best!";

const pageTitle: string = `Products | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://lellepart.hu/products",
    url: "https://lellepart.hu/products",
    name: "Apartment House | lellepart",
    description:
      "At Lellepart Apartment House, you can spend your vacation in fully satisfying comfort. Our private, sandy beach, reminiscent of seaside shores, is an ideal place even for families with small children.",
    isPartOf: {
      "@type": "WebSite",
      url: "https://lellepart.hu",
      name: "Lellepart",
      description: "Lellepart Apartmanház.",
    },
    inLanguage: "en-US",
  }}
>
  <section class="hero">
    <div class="hero-content">
      <h1>{title}</h1>
      {subTitle && <p>{subTitle}</p>}
    </div>
    <div class="hero-pattern"></div>
  </section>

  { <section class="products">
    <div class="products-grid">
      {
        product.map((product, index) => {
          const position = index % 4;
          const englishTitle = (product.data as any).title_en || product.data.title;
          if (position === 0 || position === 3) {
            return <CardSmall product={{...product, data: {...product.data, title: englishTitle}}} />;
          } else {
            return <CardWide product={{...product, data: {...product.data, title: englishTitle}}} />;
          }
        })
      }
    </div>
  </section>}

  <FeaturesStatsAlt
    title="Why Choose Lellepart Apartment House?"
    subTitle="Whether you're planning a romantic getaway or a family vacation, our apartments offer comfort and stunning views."
    benefits={[
      "Modern and comfortable apartments for a peaceful retreat.",
      "Excellent location with beautiful views of Lake Balaton.",
      "Private beach access for an exclusive experience.",
    ]}
  
  />
</MainLayout>

<style>
  .hero {
    display: flex;
    align-items: center;
    min-height: 40vh;
    padding: 7rem 2rem 2rem;
    background: theme('backgroundImage.primary-gradient');
    position: relative;
  }

  .hero-pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.1) 1px, transparent 0);
    background-size: 40px 40px;
    animation: patternMove 20s linear infinite;
    pointer-events: none;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: theme('backgroundImage.shimmer-gradient');
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    z-index: 2;
    opacity: 0;
    animation: fadeSlideUp 1s ease-out forwards;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: white;
    margin-bottom: 1rem;
    font-weight: 700;
  }

  .hero p {
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.6;
  }

  .products {
    padding: 4rem 2rem;
    background: theme('colors.background.light');
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  @keyframes patternMove {
    0% { transform: translate(0); }
    100% { transform: translate(-20px, -20px); }
  }


  @keyframes fadeSlideUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: 6rem 1rem 2rem;
    }

    .hero-content {
      padding: 1rem;
    }

    .hero h1 {
      font-size: 2rem;
      margin-bottom: 0.5rem;
    }

    .hero p {
      font-size: 1rem;
      margin-bottom: 1.5rem;
    }

    .products {
      padding: 2rem 1rem;
    }

    .products-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 0 0.5rem;
    }
  }
</style>
