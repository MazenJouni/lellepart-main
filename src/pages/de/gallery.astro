---
import MainLayout from "@/layouts/MainLayout.astro";
import { Image } from "astro:assets";
import { SITE } from "@data/constants";

// Import all gallery images from src/images/gallery/
import gallery1 from "src/images/gallery/IMG_2885.jpg";
import gallery2 from "src/images/gallery/IMG_2881.jpg";
import gallery3 from "src/images/gallery/IMG_2888.jpg";
import gallery4 from "src/images/gallery/IMG_2883.jpg";
import gallery5 from "src/images/gallery/IMG_2858.png";
import gallery6 from "src/images/gallery/IMG_2853.jpg";
import gallery7 from "src/images/gallery/IMG_2860.jpg";
import gallery8 from "src/images/gallery/IMG_2847.jpg";
import gallery9 from "src/images/gallery/IMG_2851.jpg";
import gallery10 from "src/images/gallery/IMG_2845.png";
import gallery11 from "src/images/gallery/IMG_2842.png";
import gallery12 from "src/images/gallery/IMG_2884.jpg";
import gallery13 from "src/images/gallery/IMG_2841.png";
import gallery14 from "src/images/gallery/IMG_2843.png";

const galleryImages = [
  { src: gallery1 },
  { src: gallery2 },
  { src: gallery3 },
  { src: gallery4 },
  { src: gallery5 },
  { src: gallery6 },
  { src: gallery7 },
  { src: gallery8 },
  { src: gallery9 },
  { src: gallery10 },
  { src: gallery11 },
  { src: gallery12 },
  { src: gallery13 },
  { src: gallery14 },
];

// Define variables for page content
const title: string = "Galerie";
const subTitle: string = "Entdecken Sie die Schönheit des Lellepart Apartmanház und des Balaton durch unsere Bilder!";

const pageTitle: string = `Galerie | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://lellepart.hu/de/gallery",
    url: "https://lellepart.hu/de/gallery",
    name: "Galerie | lellepart",
    description: "Galerie des Lellepart Apartmanház - entdecken Sie unsere Unterkunft und die Umgebung des Balaton durch unsere Bilder.",
    isPartOf: {
      "@type": "WebSite",
      url: "https://lellepart.hu",
      name: "Lellepart",
      description: "Lellepart Apartmanház.",
    },
    inLanguage: "de-DE",
  }}
>
  <section class="hero">
    <div class="hero-content">
      <h1>{title}</h1>
      {subTitle && <p>{subTitle}</p>}
    </div>
    <div class="hero-pattern"></div>
  </section>

  <section class="gallery">
    <div class="gallery-grid">
      {galleryImages.map((image: any, index: number) => (
        <div class="gallery-item" data-index={index}>
          <div class="image-container">
            <Image
              src={image.src}
              alt="Gallery Image"
              class="gallery-image"
              loading="lazy"
              decoding="async"
            />
            <div class="image-overlay">
              <button class="view-btn" data-index={index}>
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
</MainLayout>

<!-- Lightbox Modal -->
<div class="lightbox-modal" id="lightbox-modal">
  <div class="lightbox-content">
    <button class="close-btn" id="close-lightbox">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <button class="nav-btn prev-btn" id="prev-btn">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>
    <button class="nav-btn next-btn" id="next-btn">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>
    <div class="lightbox-image-container">
      <img id="lightbox-image" src="" alt="Gallery Image" class="lightbox-image">
    </div>
  </div>
</div>

<style>
  .hero {
    display: flex;
    align-items: center;
    min-height: 40vh;
    padding: 7rem 2rem 2rem;
    background: theme('backgroundImage.primary-gradient');
    position: relative;
  }

  .hero-pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.1) 1px, transparent 0);
    background-size: 40px 40px;
    animation: patternMove 20s linear infinite;
    pointer-events: none;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: theme('backgroundImage.shimmer-gradient');
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    z-index: 2;
    opacity: 0;
    animation: fadeSlideUp 1s ease-out forwards;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: white;
    margin-bottom: 1rem;
    font-weight: 700;
  }

  .hero p {
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.6;
  }

  .gallery {
    padding: 4rem 2rem;
    background: theme('colors.background.light');
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 2rem;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .gallery-item {
    opacity: 1;
    transform: scale(1);
    transition: all 0.3s ease;
  }

  .image-container {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
    cursor: pointer;
  }

  .image-container:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
  }

  .gallery-image {
    width: 100%;
    height: 300px;
    object-fit: cover;
    transition: transform 0.3s ease;
    background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
  }

  .image-container:hover .gallery-image {
    transform: scale(1.05);
  }

  .image-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(33, 147, 176, 0.9) 0%, rgba(109, 213, 237, 0.7) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 1rem;
  }

  .image-container:hover .image-overlay {
    opacity: 1;
  }

  .view-btn {
    background: white;
    color: #2193b0;
    border: none;
    border-radius: 50%;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
  }

  .view-btn:hover {
    background: #2193b0;
    color: white;
    transform: scale(1.1);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
  }

  /* Lightbox Styles */
  .lightbox-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.95);
    z-index: 3000;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    backdrop-filter: blur(5px);
  }

  .lightbox-modal.active {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-content {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .close-btn {
    position: absolute;
    top: 2rem;
    right: 2rem;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: white;
    border-radius: 50%;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
  }

  .close-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
  }

  .nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: white;
    border-radius: 50%;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
  }

  .nav-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-50%) scale(1.1);
  }

  .prev-btn {
    left: 2rem;
  }

  .next-btn {
    right: 2rem;
  }

  .lightbox-image-container {
    max-width: 90%;
    max-height: 90%;
    text-align: center;
  }

  .lightbox-image {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
  }

  @keyframes patternMove {
    0% { transform: translate(0); }
    100% { transform: translate(-20px, -20px); }
  }

  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }

  @keyframes fadeSlideUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 924px) {
    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 0 1rem;
    }

    .gallery-image {
      height: 250px;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: 6rem 1rem 2rem;
    }

    .hero-content {
      padding: 1rem;
    }

    .hero h1 {
      font-size: 2rem;
      margin-bottom: 0.5rem;
    }

    .hero p {
      font-size: 1rem;
      margin-bottom: 1.5rem;
    }

    .gallery {
      padding: 2rem 0.5rem;
    }

    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 0;
    }

    .gallery-image {
      height: 180px;
    }

    .nav-btn {
      display: none;
    }

    .close-btn {
      top: 1rem;
      right: 1rem;
      width: 40px;
      height: 40px;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding: 6rem 1rem 2rem;
    }

    .hero-content {
      padding: 1rem;
    }

    .hero h1 {
      font-size: 1.75rem;
    }

    .hero p {
      font-size: 0.9rem;
    }

    .gallery {
      padding: 1.5rem 0.25rem;
    }

    .gallery-grid {
      gap: 0.75rem;
      padding: 0;
    }

    .gallery-image {
      height: 200px;
    }

    .view-btn {
      width: 36px;
      height: 36px;
    }

    .image-overlay {
      gap: 0.5rem;
    }

    .nav-btn {
      display: none;
    }
  }
</style>

<script>
  // Gallery functionality
  document.addEventListener('DOMContentLoaded', () => {
    const galleryItems = document.querySelectorAll('.gallery-item');
    const lightboxModal = document.getElementById('lightbox-modal');
    const lightboxImage = document.getElementById('lightbox-image');
    const closeBtn = document.getElementById('close-lightbox');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const viewBtns = document.querySelectorAll('.view-btn');

    let currentImageIndex = 0;
    const images = Array.from(galleryItems);

    // Touch/swipe variables
    let touchStartX = 0;
    let touchEndX = 0;
    let touchStartY = 0;
    let touchEndY = 0;

    // Lightbox functionality
    function openLightbox(index: number) {
      const item = images[index];
      const imgElement = item.querySelector('.gallery-image');

      if (lightboxImage instanceof HTMLImageElement && imgElement && imgElement instanceof HTMLImageElement) {
        lightboxImage.src = imgElement.src;
        lightboxImage.alt = imgElement.alt;
      }
      
      currentImageIndex = index;

      if (lightboxModal) {
        lightboxModal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeLightbox() {
      if (lightboxModal) {
        lightboxModal.classList.remove('active');
        document.body.style.overflow = 'auto';
      }
    }

    function showNext() {
      currentImageIndex = (currentImageIndex + 1) % images.length;
      openLightbox(currentImageIndex);
    }

    function showPrev() {
      currentImageIndex = currentImageIndex === 0 ? images.length - 1 : currentImageIndex - 1;
      openLightbox(currentImageIndex);
    }

    // Touch event handlers
    function handleTouchStart(e: TouchEvent) {
      touchStartX = e.changedTouches[0].screenX;
      touchStartY = e.changedTouches[0].screenY;
    }

    function handleTouchEnd(e: TouchEvent) {
      touchEndX = e.changedTouches[0].screenX;
      touchEndY = e.changedTouches[0].screenY;
      handleSwipe();
    }

    function handleSwipe() {
      const diffX = touchStartX - touchEndX;
      const diffY = touchStartY - touchEndY;
      
      // Check if it's a horizontal swipe (not vertical)
      if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 50) {
        if (diffX > 0) {
          // Swipe left - next image
          showNext();
        } else {
          // Swipe right - previous image
          showPrev();
        }
      }
    }

    // Event listeners for view buttons
    viewBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const index = parseInt((btn as HTMLElement).dataset.index || '0');
        if (!isNaN(index)) {
          openLightbox(index);
        }
      });
    });

    // Event listeners for image containers (click anywhere on image)
    galleryItems.forEach((item, index) => {
      item.addEventListener('click', () => {
        openLightbox(index);
      });
    });

    // Lightbox controls
    if (closeBtn) {
      closeBtn.addEventListener('click', closeLightbox);
    }
    
    if (prevBtn) {
      prevBtn.addEventListener('click', showPrev);
    }
    
    if (nextBtn) {
      nextBtn.addEventListener('click', showNext);
    }

    // Touch events for mobile navigation
    if (lightboxModal) {
      lightboxModal.addEventListener('touchstart', handleTouchStart, { passive: true });
      lightboxModal.addEventListener('touchend', handleTouchEnd, { passive: true });
    }

    // Close lightbox on background click
    if (lightboxModal) {
      lightboxModal.addEventListener('click', (e) => {
        if (e.target === lightboxModal) {
          closeLightbox();
        }
      });
    }

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (!lightboxModal || !lightboxModal.classList.contains('active')) return;

      switch(e.key) {
        case 'Escape':
          closeLightbox();
          break;
        case 'ArrowLeft':
          showPrev();
          break;
        case 'ArrowRight':
          showNext();
          break;
      }
    });
  });
</script>
